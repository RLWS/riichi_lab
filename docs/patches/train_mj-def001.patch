diff --git a/tests/test_chankan_target.py b/tests/test_chankan_target.py
new file mode 100644
index 0000000000000000000000000000000000000000..1a018d4233b79e62d4a25cd111f8e0032a795f82
--- /dev/null
+++ b/tests/test_chankan_target.py
@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+import pytest
+
+from mjai.data.builders.sample_builder import ResponseSampleBuilder
+from mjai.data.schema.events import Event
+
+
+@pytest.mark.parametrize("called,added", [("5m", "0m"), ("0m", "5m"), ("4m", "4m")])
+@pytest.mark.parametrize("win", [True, False])
+def test_chankan_uses_added_tile_and_pre_upgrade_state(called, added, win):
+    rank = 5 if "0m" in (called, added) else 4
+    normal = f"{rank}m"
+    responder = [
+        "1p",
+        "2p",
+        "3p",
+        "1s",
+        "2s",
+        "3s",
+        "1z",
+        "1z",
+        "1z",
+        "2z",
+        "2z",
+        f"{rank - 1}m",
+        f"{rank + 1}m",
+    ]
+    payload = {
+        "seed": "0,0,0",
+        "ten": "250,250,250,250",
+        "oya": 0,
+        "round_wind": 0,
+        "round_number": 0,
+        "match_rounds": 8,
+        "dora_indicator": "9s",
+        "hai0": [normal, normal, "1m", "2m", "3m", "7p", "8p", "9p", "7s", "8s", "9s", "5z", "5z"],
+        "hai1": responder,
+        "hai2": [called],
+        "hai3": [],
+    }
+    # Minimal normalized setup: only hands consumed in the scenario need tiles.
+    specs = [
+        ("init", None, payload),
+        ("discard", 2, {"tile": called}),
+        (
+            "meld",
+            0,
+            {"kind": "pon", "source": 2, "called_tile": called, "consumed_tiles": [normal, normal]},
+        ),
+        ("discard", 0, {"tile": "1m"}),
+        ("draw", 1, {"tile": "9p"}),
+        ("discard", 1, {"tile": "9p"}),
+        ("draw", 0, {"tile": added}),
+        (
+            "meld",
+            0,
+            {
+                "kind": "kakan",
+                "source": 2,
+                "called_tile": called,
+                "consumed_tiles": [normal, normal, added],
+            },
+        ),
+    ]
+    if win:
+        specs.append(("agari", 1, {"who": "1", "fromWho": "0"}))
+    else:
+        specs.extend([("draw", 0, {"tile": "9m"}), ("discard", 0, {"tile": "9m"})])
+    events = [
+        Event("red_kan", 0, step, kind, actor, payload=data)
+        for step, (kind, actor, data) in enumerate(specs)
+    ]
+    samples = ResponseSampleBuilder().build_samples(events)
+    sample = next(s for s in samples if s.actor == 1 and s.step_index == 7)
+    assert sample.state["response_target"] == {"source": 0, "tile": added}
+    wins = [a for a in sample.legal_actions if a["kind"] in {"ron", "chankan"}]
+    assert wins and all(a["tile"] == added for a in wins)
+    assert sample.state["all_melds"][0][0]["kind"] == "pon"
+    assert sample.state["all_melds"][0][0]["called_tile"] == called
+    assert not any(e["kind"] == "kakan" for e in sample.state["public_events"])
+    if win:
+        assert sample.label_action["kind"] == "chankan"
+        assert sample.label_action["tile"] == added
+        assert sample.label_action in sample.legal_actions
+    else:
+        follow = next(s for s in samples if s.actor == 1 and s.step_index == 9)
+        assert follow.state["temporary_furiten"] is True
